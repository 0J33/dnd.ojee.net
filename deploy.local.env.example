# Copy to deploy.local.env (gitignored) and fill in the real values.
# deploy.sh sources this file so the SSH password never sits in the repo or
# shows up on a process command line.
REMOTE_HOST=10.0.0.0
REMOTE_USER=changeme
# Omit SSHPASS entirely if you use key-based auth.
SSHPASS=changeme

# Optional override — Vite inlines this at build time.
# DND_API_URL=https://dnd-api.ojee.net
